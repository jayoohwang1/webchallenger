webchallenger.lock

# Runtime outputs (keep the folders, ignore their contents)
webchallenger/results/*
!webchallenger/results/.gitkeep
webchallenger/memory/screenshots/*
!webchallenger/memory/screenshots/.gitkeep
webchallenger/memory/saved_files/*
!webchallenger/memory/saved_files/.gitkeep

